# 魔搭社区 ModelScope API Token 配置模板
# 获取地址：https://modelscope.cn/my/myaccesstoken
#
# 使用步骤：
# 1. 复制本文件，重命名为 .env（与 server.py 同目录）
# 2. 把下面的 your_modelscope_token_here 替换成你自己的 Access Token
# 3. 重启 server.py
#
# 注意：.env 已被 .gitignore 忽略，不会进入版本库；也不要把它发给别人。

MODELSCOPE_API_TOKEN=your_modelscope_token_here
